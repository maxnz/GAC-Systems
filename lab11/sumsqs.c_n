  1: /* sumsqs.c - example of iteration in C language.  Richard Brown 9/2010 */
  2:
  3: #include <stdio.h>
  4:
  5: int main() {
  6:   int n;
  7:   int result = 0;
  8:   int i;
  9:
 10:   printf("Enter a positive integer:  ");
 11:   scanf("%d", &n);
 12:
 13:   i = 0;
 14:   while (i <= n) {
 15:     result = result + i*i;
 16:     i++;
 17:   }
 18:
 19:   printf("The sum of the first %d squares is %d.\n", n, result);
 20:   return 0;
 21: }
